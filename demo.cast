[0.000, "o", "mysh built-in commands:\r\n  cd [dir]          change the working directory (default: $HOME)\r\n  exit [code]       exit the shell (default: last command's status)\r\n  export NAME=VALUE set an environment variable for child processes\r\n"]
[0.000, "o", "  history           list previously entered commands\r\n  jobs              list background and stopped jobs\r\n  fg %jobid         resume a job in the foreground\r\n  bg %jobid         resume a stopped job in the background\r\n"]
[0.000, "o", "  kill %jobid|pid   send SIGTERM to a job or pid\r\n  help              show this message\r\n\r\nEverything else is run as an external program via fork/exec.\r\nmysh> "]
